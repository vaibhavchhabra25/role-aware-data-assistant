# Company-provided Railway DB. READ-ONLY: only used once, to take the snapshot.
SOURCE_DATABASE_URL=postgresql://user:password@host:port/dbname

# Local working copy (docker compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/manufacturing

# Per-role read-only Postgres logins on the local DB (any random strings)
ROLE_INVENTORY_PASSWORD=change-me
ROLE_PROCUREMENT_PASSWORD=change-me
ROLE_OWNER_PASSWORD=change-me

# The company data ends here; the assistant treats this date as "today"
DATA_AS_OF=2026-08-21

# OpenAI
OPENAI_API_KEY=sk-...
GUARD_MODEL=gpt-4.1
SQL_MODEL=gpt-4.1
FAST_MODEL=gpt-4.1-mini
# Optional: another OpenAI-compatible provider, e.g. Groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# then set the three models, e.g. openai/gpt-oss-120b (guard, SQL) and openai/gpt-oss-20b (fast)
# Cache identical LLM calls on disk during development (1 = on, 0 = off)
LLM_CACHE=1

# LangSmith tracing
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=lecxe-data-assistant
LANGSMITH_TRACING=true

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Login: JWT signing secret (long random string) and demo user passwords
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_MINUTES=480
DEMO_INVENTORY_PASSWORD=change-me
DEMO_PROCUREMENT_PASSWORD=change-me
DEMO_OWNER_PASSWORD=change-me

# Writer logins used only for confirmed write actions
ROLE_PROCUREMENT_WRITER_PASSWORD=change-me
ROLE_INVENTORY_WRITER_PASSWORD=change-me
